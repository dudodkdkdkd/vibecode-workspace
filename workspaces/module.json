{
  "entries": [
    {"id": "launch", "order": 10, "title": "Einmaliger Workspace: Projekte auswählen und starten",
     "run": ["{module}/VibeCode Workspace.command"]},
    {"id": "setup", "order": 20, "title": "Repository-Ordner, Terminals und URLs einrichten",
     "run": ["{module}/Setup VibeCode Workspace.command"],
     "status": ["{module}/VibeCode Workspace.command", "--summary"]},
    {"id": "preset-store", "title": "Presets pro Repository (Terminals und Browser-Tabs)",
     "run": ["/usr/bin/osascript", "-l", "JavaScript", "{module}/presets.js", "{module}"]},
    {"id": "search-folders", "title": "Suchordner für Repositories (lokal)",
     "run": ["python3", "{module}/local-folders.py"]},
    {"id": "hosts", "title": "SSH-Hosts mit Repository-Suche (Auflistung, Einrichtung)",
     "run": ["python3", "{module}/remote-hosts.py"]}
  ]
}
