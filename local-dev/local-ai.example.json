{
  "$schema": "./local-ai.schema.json",
  "config_version": 2,
  "provider": "mlx",
  "model": "XHToken/Spark-X2.5-4B",
  "framework": "opencode",
  "start_timeout_seconds": 180,
  "memory_management": {
    "enabled": true,
    "close_apps_on_start": ["Google Chrome"],
    "restore_apps_on_stop": true
  },
  "hardware_profile": "m2-max-32gb",
  "hardware_profiles": {
    "m2-max-32gb": {
      "name": "Apple M2 Max · 32 GB",
      "chip": "Apple M2 Max",
      "unified_memory_gb": 32,
      "providers": {
        "mlx": {
          "server_args": [
            "--prompt-cache-size", "1",
            "--prompt-cache-bytes", "4GB",
            "--prompt-concurrency", "1",
            "--decode-concurrency", "2",
            "--prefill-step-size", "1024"
          ],
          "model_limits": {
            "context": 24576,
            "input": 24576,
            "output": 4096
          }
        }
      }
    }
  },
  "providers": {
    "mlx": {
      "type": "mlx",
      "protocol": "openai-chat",
      "provider_id": "mlx",
      "name": "MLX (lokal)",
      "default_model": "XHToken/Spark-X2.5-4B",
      "host": "127.0.0.1",
      "port": 8000,
      "server_command": "~/Spark-MLX-LLM/.venv/bin/spark-mlx-server",
      "server_args": [],
      "health_path": "/health",
      "readiness_path": "/chat/completions",
      "readiness_timeout_seconds": 30,
      "readiness_max_tokens": 1
    },
    "ollama": {
      "type": "ollama",
      "protocol": "openai-chat",
      "provider_id": "ollama",
      "name": "Ollama (lokal)",
      "default_model": "deepseek-coder:6.7b",
      "host": "127.0.0.1",
      "port": 11434,
      "server_command": "ollama",
      "health_path": "/api/tags"
    }
  },
  "frameworks": {
    "opencode": {
      "adapter": "opencode",
      "name": "OpenCode",
      "command": "opencode",
      "args": [],
      "working_directory": ".",
      "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 4096
      }
    },
    "codex": {
      "adapter": "codex",
      "name": "Codex CLI",
      "command": "codex",
      "args": [],
      "working_directory": "."
    },
    "claude": {
      "adapter": "claude",
      "name": "Claude Code",
      "command": "claude",
      "args": [],
      "working_directory": "."
    }
  }
}
