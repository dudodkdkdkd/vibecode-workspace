{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecode.local/local-ai.schema.json",
  "title": "VibeCode Local AI Launcher",
  "type": "object",
  "required": ["provider", "model", "framework", "providers", "frameworks"],
  "properties": {
    "config_version": { "type": "integer", "minimum": 2 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "start_timeout_seconds": { "type": "integer", "minimum": 1 },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "protocol", "provider_id", "name"],
        "properties": {
          "type": { "enum": ["mlx", "ollama", "openai-compatible"] },
          "protocol": { "enum": ["openai-chat", "openai-responses", "anthropic"] },
          "provider_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "default_model": { "type": "string", "minLength": 1 },
          "host": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "base_url": { "type": "string" },
          "health_url": { "type": "string" },
          "health_path": { "type": "string" },
          "readiness_path": { "type": "string" },
          "readiness_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
          "readiness_max_tokens": { "type": "integer", "minimum": 1, "maximum": 64 },
          "server_command": { "type": "string" },
          "server_args": { "type": "array", "items": { "type": "string" } },
          "start_command": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "frameworks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["adapter", "name", "command"],
        "properties": {
          "adapter": { "enum": ["opencode", "codex", "claude", "generic"] },
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "working_directory": { "type": "string" }
        }
      }
    }
  }
}
